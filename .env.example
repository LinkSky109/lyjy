# 本地开发环境变量示例
# 复制为 .env 后按需修改；.env 不进入版本库。

POSTGRES_DB=lhjypt
POSTGRES_USER=lhjypt
POSTGRES_PASSWORD=lhjypt_local_dev
POSTGRES_URL=jdbc:postgresql://localhost:5432/lhjypt

CLICKHOUSE_URL=jdbc:clickhouse://localhost:8123/lhjypt
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
LHJYPT_TRADE_MODE=MOCK
