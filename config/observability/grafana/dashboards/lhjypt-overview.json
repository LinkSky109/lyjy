    {
      "id": 9,
      "type": "timeseries",
      "title": "JVM Heap 使用",
      "datasource": { "type": "prometheus", "uid": "lhjypt-prom" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "lhjypt-prom" },
